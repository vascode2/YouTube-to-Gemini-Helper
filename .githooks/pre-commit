#!/usr/bin/env bash
# Pre-commit hook: refresh an auto-generated "Recent activity" block in
# README.md, CLAUDE.md, and docs/troubleshooting.md so the docs always
# reflect the latest project state.
#
# - The block is delimited by HTML comment markers; only content between
#   the markers is rewritten. Anything outside is untouched.
# - The hook re-stages those files after rewriting so the updates land in
#   the same commit.
# - The block contents are deterministic given the repo state, so re-running
#   the hook on the same commit produces no further changes (no infinite
#   loop on `git commit --amend` or hook reruns).
#
# Install: handled automatically by `git config core.hooksPath .githooks`.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

BEGIN="<!-- AUTO:RECENT-ACTIVITY:BEGIN -->"
END="<!-- AUTO:RECENT-ACTIVITY:END -->"

now_iso="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

# Last 5 commits already on HEAD (the about-to-be-created commit is NOT yet here;
# it will appear on the next hook run, which is the intentional rolling window).
recent_commits="$(git log -5 --pretty=format:'- `%h` %s _(%ar)_' 2>/dev/null || true)"
if [ -z "$recent_commits" ]; then
  recent_commits="- _(no commits yet)_"
fi

# Files staged for THIS commit (gives a preview of what's about to land).
staged_files="$(git diff --cached --name-only | sort -u)"
if [ -z "$staged_files" ]; then
  staged_preview="- _(no files staged)_"
else
  staged_preview="$(printf '%s\n' "$staged_files" | sed 's|^|- `|; s|$|`|')"
fi

block="$(cat <<EOF
$BEGIN
<!-- This block is regenerated by .githooks/pre-commit on every commit.
     Do not edit by hand — your changes will be overwritten. -->

**Last updated:** \`$now_iso\`

**Recent commits (last 5 on HEAD):**

$recent_commits

**Files in the pending commit:**

$staged_preview
$END
EOF
)"

update_file() {
  local path="$1"
  [ -f "$path" ] || return 0

  if grep -qF "$BEGIN" "$path"; then
    # Replace existing block in-place.
    python3 - "$path" "$BEGIN" "$END" "$block" <<'PY'
import sys, re, pathlib
path, begin, end, new_block = sys.argv[1:5]
text = pathlib.Path(path).read_text(encoding="utf-8")
pattern = re.compile(re.escape(begin) + r".*?" + re.escape(end), re.DOTALL)
new_text = pattern.sub(new_block, text, count=1)
if new_text != text:
    pathlib.Path(path).write_text(new_text, encoding="utf-8")
PY
  else
    # Append at end with a separating blank line.
    printf '\n\n%s\n' "$block" >> "$path"
  fi

  # Only re-stage if the file actually changed in the working tree relative to
  # what's already staged. Avoids creating empty hook noise.
  if ! git diff --quiet -- "$path"; then
    git add -- "$path"
  fi
}

update_file "README.md"
update_file "CLAUDE.md"
update_file "docs/troubleshooting.md"

exit 0
