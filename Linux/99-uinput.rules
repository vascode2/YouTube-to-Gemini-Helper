# Give the 'input' group read/write access to /dev/uinput so ydotoold can run
# without root. Install:
#   sudo cp Linux/99-uinput.rules /etc/udev/rules.d/99-uinput.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   sudo usermod -aG input "$USER"     # then log out/in (or reboot)
#
# Verify the node afterwards:
#   ls -l /dev/uinput   ->   crw-rw---- 1 root input ... /dev/uinput
KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
